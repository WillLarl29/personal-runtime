{
    "swagger": "2.0",
    "info": {
        "description": "API para gestionar actividades y sus checks diarios.",
        "title": "API de Actividades",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/actividades": {
            "get": {
                "description": "Devuelve las actividades activas, ordenadas por id",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "actividades"
                ],
                "summary": "Listar actividades",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Actividad"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "actividades"
                ],
                "summary": "Crear actividad",
                "parameters": [
                    {
                        "description": "Datos de la actividad",
                        "name": "actividad",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CrearActividadInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.Actividad"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/checks": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checks"
                ],
                "summary": "Dar check a una actividad hoy",
                "parameters": [
                    {
                        "description": "Datos del check",
                        "name": "check",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CrearCheckInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.CheckDiario"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/resumen": {
            "get": {
                "description": "Usa la vista resumen_actividades",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "resumen"
                ],
                "summary": "Resumen de cumplimiento por actividad",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.ResumenActividad"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Actividad": {
            "type": "object",
            "properties": {
                "activa": {
                    "type": "boolean"
                },
                "actualizado_en": {
                    "type": "string"
                },
                "categoria": {
                    "type": "string"
                },
                "creado_en": {
                    "type": "string"
                },
                "descripcion": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "prioridad": {
                    "type": "integer"
                },
                "titulo": {
                    "type": "string"
                }
            }
        },
        "main.CheckDiario": {
            "type": "object",
            "properties": {
                "actividad_id": {
                    "type": "integer"
                },
                "creado_en": {
                    "type": "string"
                },
                "fecha": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "nota": {
                    "type": "string"
                }
            }
        },
        "main.CrearActividadInput": {
            "type": "object",
            "properties": {
                "categoria": {
                    "type": "string"
                },
                "descripcion": {
                    "type": "string"
                },
                "prioridad": {
                    "type": "integer"
                },
                "titulo": {
                    "type": "string"
                }
            }
        },
        "main.CrearCheckInput": {
            "type": "object",
            "properties": {
                "actividad_id": {
                    "type": "integer"
                },
                "nota": {
                    "type": "string"
                }
            }
        },
        "main.ResumenActividad": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "porcentaje_cumplimiento": {
                    "type": "number"
                },
                "titulo": {
                    "type": "string"
                },
                "veces_hecha": {
                    "type": "integer"
                },
                "veces_no_hecha": {
                    "type": "integer"
                }
            }
        }
    }
}